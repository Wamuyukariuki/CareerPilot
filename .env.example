APP_ENV=development
# Generate independently: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
# Host API only: set your PostgreSQL URL. Compose builds its own DATABASE_URL.
DATABASE_URL=sqlite:///./careerpilot.db
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0
UPLOAD_DIR=data/uploads
# Docker configures Unicode fonts; host Python can set absolute TTF paths.
PDF_FONT_PATHS=[]
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_ORIGINS=["http://localhost:5173"]
ACCESS_TOKEN_EXPIRE_MINUTES=30
POSTGRES_DB=careerpilot
POSTGRES_USER=postgres
# Generate a separate random hex value; Compose embeds it in a database URL.
POSTGRES_PASSWORD=
