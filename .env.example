APP_ENV=development
SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/careerpilot
REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_STORAGE_URI=redis://localhost:6379/0
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_BYTES=10485760
ALLOWED_ORIGINS=["http://localhost:5173"]
ACCESS_TOKEN_EXPIRE_MINUTES=30
POSTGRES_DB=careerpilot
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-this-local-password
